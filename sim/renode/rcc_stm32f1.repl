// STM32F1 RCC behavioral stub overlay — lets any Zephyr STM32F1 image boot
// on Renode's stm32f103 platform (clock-ready polling would hang otherwise).
// Ready bits always set; CFGR.SWS mirrors SW. State: per-offset last write.
rcc: Python.PythonPeripheral @ sysbus <0x40021000, +0x400>
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    regs = {}
if request.IsWrite:
    regs[request.Offset] = request.Value
if request.IsRead:
    v = regs.get(request.Offset, 0)
    if request.Offset == 0x0:
        # ready bits mirror their ON bits: HSIRDY<-HSION, HSERDY<-HSEON, PLLRDY<-PLLON
        request.Value = (v & ~0x02020002) | ((v & 0x01010001) << 1)
    elif request.Offset == 0x4:
        request.Value = (v & ~0xC) | ((v & 0x3) << 2)
    else:
        request.Value = v
'''

// FLASH controller (ACR latency readback poll) — write-through register RAM.
flashctl: Python.PythonPeripheral @ sysbus <0x40022000, +0x400>
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    regs = {}
if request.IsWrite:
    regs[request.Offset] = request.Value
if request.IsRead:
    request.Value = regs.get(request.Offset, 0)
'''
